{
  "_comment": "Copy to mnist_config.json and edit. Paths are relative to demo/mnist/.",

  "ssh": {
    "host": "kv260.local",
    "user": "root",
    "port": 22,

    "key_file": "~/.ssh/id_rsa",
    "_key_file_note": "Path to SSH private key; null for password auth.",

    "password": null,
    "connect_timeout": 15
  },

  "remote": {
    "work_dir": "/tmp/mnist_demo",
    "_work_dir_note": "Per-run scratch directory on the board. Created if missing.",

    "uio_devices": {
      "VectorOPKernel": "fabric_vecop",
      "MatmulKernel":   "fabric_matmul",
      "ConvKernel":     "fabric_conv",
      "PoolKernel":     "fabric_pool"
    },
    "_uio_devices_note": "DT node labels from the loaded overlay. Verify on the board with: cat /sys/class/uio/uio*/name",

    "cmake_args": []
  },

  "local": {
    "driver_dirs": {
      "VectorOPKernel": "../../build/kernels/vectorop_rtl/driver/VectorOPKernel_v1_0/src",
      "MatmulKernel":   "../../build/kernels/matmul_rtl/driver/MatmulKernel_v1_0/src",
      "ConvKernel":     "../../build/kernels/conv/kv260/conv_kv260/hls/impl/ip/drivers/ConvKernel_v1_0/src",
      "PoolKernel":     "../../build/kernels/pool/kv260/pool_kv260/hls/impl/ip/drivers/PoolingKernel_v1_0/src"
    },
    "_driver_dirs_note": "Per-kernel driver sources (the HLS exports; VectorOPKernel's and MatmulKernel's from make driver_vectorop_rtl / driver_matmul_rtl), copied into each project before upload."
  },

  "build": {
    "jobs": 4,
    "timeout": 300
  },

  "run": {
    "timeout": 600,
    "use_sudo": true,
    "iters": 0,
    "_iters_note": "Number of test images per benchmark run. 0 = use all 10 000 from the MNIST test set.",
    "warmup": 50,
    "profile_layers": false,
    "_profile_layers_note": "Enable per-layer wall-clock stats. Cross-build adds -DINFERENCE_PROFILING=ON; bench_mnist appends a 'LAYERS_JSON: {...}' line that lands under metrics.layer_stats in build/results.json. Override per-run with deploy_and_run.py --profile-layers.",

    "env": {
      "_comment": "Per-run environment variables forwarded to bench_mnist on the board (via `env K=V ./bench_mnist ...`, after sudo). Used to tune the inference_ddr backend without recompiling.",
      "_INFERENCE_DDR_APM_BASE":  "Override the APM base address (default 0xFD490000 = ZU+ DDR APM)",
      "_INFERENCE_DDR_APM_SLOTS": "Comma-separated DDRC port slots to monitor, up to 5 (e.g. \"3,4\"; default \"0\")",
      "_INFERENCE_DDR_BACKEND":   "Force a specific backend, or 'disabled' to skip DDR sampling"
    }
  },

  "models": [
    {
      "name": "mnist_convnet",
      "drive_filename": "mnist-simplified.onnx",
      "_drive_filename_note": "File name inside the Google Drive folder. Downloaded by scripts/download_assets.py."
    },
    {
      "name": "mnist_lenet",
      "drive_filename": "lenet_simplified.onnx"
    }
  ],

  "drive": {
    "folder_url": "https://drive.google.com/drive/u/0/folders/1cx8Vy6LrGhG2_TQMc9TJZqqyr9_GZqFs",
    "_folder_url_note": "Google Drive folder containing the ONNX models. Downloaded with `gdown --folder`."
  },

  "cleanup": true
}
