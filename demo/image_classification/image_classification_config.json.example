{
  "_comment": "Copy to image_classification_config.json and edit. Paths are relative to demo/image_classification/.",

  "ssh": {
    "host": "kv260.local",
    "user": "root",
    "port": 22,

    "key_file": "~/.ssh/id_rsa",
    "_key_file_note": "Path to SSH private key; null for password auth.",

    "password": null,
    "connect_timeout": 15
  },

  "remote": {
    "work_dir": "/tmp/image_classification_demo",
    "_work_dir_note": "Per-run scratch directory on the board. Created if missing.",

    "uio_devices": {
      "VectorOPKernel": "fabric_vecop",
      "MatmulKernel":   "fabric_matmul",
      "ConvKernel":     "fabric_conv",
      "PoolKernel":     "fabric_pool"
    },
    "_uio_devices_note": "DT node labels from the loaded overlay. Verify with: cat /sys/class/uio/uio*/name",

    "cmake_args": []
  },

  "local": {
    "driver_dirs": {
      "VectorOPKernel": "../../build/kernels/vectorop/kv260/vadd_kv260/solution1/impl/ip/drivers/VectorOPKernel_v1_0/src",
      "MatmulKernel":   "../../build/kernels/matmul_rtl/driver/MatmulKernel_v1_0/src",
      "ConvKernel":     "../../build/kernels/conv/kv260/conv_kv260/hls/impl/ip/drivers/ConvKernel_v1_0/src",
      "PoolKernel":     "../../build/kernels/pool/kv260/pool_kv260/hls/impl/ip/drivers/PoolingKernel_v1_0/src"
    },
    "_driver_dirs_note": "Per-kernel driver sources (the HLS exports; MatmulKernel's from make driver_matmul_rtl), copied into the project before upload."
  },

  "build": {
    "jobs": 4,
    "timeout": 600
  },

  "run": {
    "timeout": 900,
    "use_sudo": true,
    "warmup": 1,
    "top_k": 5,
    "_top_k_note": "Number of top predictions to print per image.",
    "profile_layers": false,

    "env": {
      "_comment": "Per-run environment variables forwarded to classify_images on the board."
    }
  },

  "preprocess": {
    "input_size": 224,
    "_input_size_note": "Square edge length the input is resized to. Default for all models; can be overridden per model.",
    "normalize":  "tf",
    "_normalize_note": "Default normalize mode. Per-model entries can override. 'tf' = (pixel/127.5) - 1.0 (TF MobileNet); 'unit' = pixel/255 (Keras-style); 'imagenet' = pixel/255 then (x - mean) / std with the standard torchvision ImageNet constants (mean=[0.485,0.456,0.406], std=[0.229,0.224,0.225]); 'none' = pixel/256 (raw bytes).",
    "resize":     "bilinear",
    "_resize_note": "PIL resampling mode: 'bilinear', 'bicubic', 'lanczos', 'nearest'."
  },

  "models": [
    {
      "name": "mobilenet_v1",
      "drive_filename": "mobilenet_v1_1.0_224_no_softmax.onnx",
      "_drive_filename_note": "File name inside the Google Drive folder. The Softmax tail is already stripped in this variant; argmax over the 1001 logits is identical.",
      "preprocess": { "normalize": "tf" },
      "_preprocess_note": "TF MobileNetV1 expects (pixel/127.5) - 1.0.",
      "labels": { "skip_background_class": false },
      "_labels_note": "TF MobileNetV1 emits 1001 logits, slot 0 == 'background'; label indices align 1:1 with the shared labels file."
    },
    {
      "name": "mobilenet_v2",
      "drive_filename": "mobilenetv2-12_simplified.onnx",
      "_drive_filename_note": "File name inside the Google Drive folder.",
      "preprocess": { "normalize": "imagenet" },
      "_preprocess_note": "ONNX Model Zoo MobileNetV2 (PyTorch-trained) expects pixel/255 then per-channel (x - mean) / std.",
      "labels": { "skip_background_class": true },
      "_labels_note": "ONNX Model Zoo MobileNetV2 emits 1000 logits; shift label lookup by +1 to skip the synthetic 'background' slot at the top of the shared file."
    },
    {
      "name": "resnet18",
      "drive_filename": "resnet18-simplified-fused.onnx",
      "_drive_filename_note": "File name inside the Google Drive folder.",
      "preprocess": { "normalize": "imagenet" },
      "_preprocess_note": "ONNX Model Zoo ResNet-18 (PyTorch-trained) expects per-channel (x - mean) / std.",
      "labels": { "skip_background_class": true },
      "_labels_note": "ONNX Model Zoo ResNet-18 emits 1000 logits; shift label lookup by +1 to skip the synthetic 'background' slot at the top of the shared file."
    }
  ],

  "drive": {
    "folder_url": "https://drive.google.com/drive/u/0/folders/10B29ZArpvtMsGm0McBC0enFPrkq0Z1vD",
    "_folder_url_note": "Google Drive folder containing the ONNX models. Downloaded with `gdown --folder`."
  },

  "labels": {
    "url": "https://storage.googleapis.com/download.tensorflow.org/data/imagenet_class_index.json",
    "_url_note": "Standard ImageNet 1000-class index. Class 0 (background) is prepended locally to match MobileNetV1's 1001-class output."
  },

  "cleanup": true
}
