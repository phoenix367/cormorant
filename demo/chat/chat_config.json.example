{
  "_comment": "Copy to chat_config.json and edit. Relative paths are relative to demo/chat/.",
  "bert_squad_config": "../bert_squad/bert_squad_config.json",
  "_bert_squad_config_note": "The BERT-SQuAD demo config: model, io roles, kernel driver dirs, remote.uio_devices, remote.weights_dir, ssh and board_lock are taken from it (the project is generated with demo/bert_squad/scripts/generate_project.py).",
  "ssh": null,
  "_ssh_note": "null = the ssh block of bert_squad_config; or {host, user, port, key_file, password, connect_timeout}.",
  "remote": {
    "dir": "/root/kv260_chat",
    "_dir_note": "Persistent install directory on the board: server files, vocab.txt, lib/libbert_squad.so, project/ (sources + build).",
    "weights_dir": null,
    "_weights_dir_note": "null = bert_squad_config remote.weights_dir (/root/bert_squad_weights); weights/*.dat are uploaded only when their size or SHA-1 changed."
  },
  "server": {
    "host": "0.0.0.0",
    "port": 8000,
    "api_key": null,
    "_api_key_note": "null = no authentication; otherwise clients send 'Authorization: Bearer <key>' (stored on the board in <dir>/api_key, mode 600).",
    "backends": [
      "bert-squad"
    ],
    "_backends_note": "Any of bert-squad, smollm2 (SmolLM2-135M), smollm2-360m, smolvlm, piper (text to speech), moonshine (speech to text), echo; the first is the default model. Each one but bert-squad and echo needs its library on the board (see its block): smollm2 libsmollm2.so, smollm2-360m libsmollm2_360m.so, smolvlm libsmolvlm_256m.so and Pillow, piper libpiper_tts.so and its voice, moonshine libmoonshine_base.so and its weights. See doc/DEPLOY.md.",
    "resident": "auto",
    "_resident_note": "auto = keep the FPGA models loaded while CmaFree allows, else swap them on demand (least recently used first); one = one FPGA model at a time; all = load everything at startup.",
    "max_windows": 8,
    "doc_stride": 128,
    "queue_timeout": 120,
    "max_queue": 16,
    "launcher": "systemd",
    "_launcher_note": "systemd = the unit /etc/systemd/system/kv260-chat.service (logs: journalctl -u kv260-chat), installed but not enabled: never started at boot, only by hand (systemctl start kv260-chat on the board, or deploy.py --start); nohup = a detached process (<dir>/server.log, <dir>/server.pid).",
    "env": {}
  },
  "fpga": {
    "bitstream_config": "../../inference-scheduler/bitstream_config_kv260.json",
    "_note": "The bitstream config (upload_bitstream.py's) that names the bitstream the board runs: deploy.py stages it in <dir>/fpga (the .bin, the overlay, the xclbin from xclbinutil, the port widths), and the unit loads it before the server when the board does not run it (after a boot: fpga_load.py).  deploy.py stops when it names another bitstream than the board runs.  null = no bundle: the bitstream must be loaded before the server starts."
  },
  "rpu": {
    "enabled": false,
    "bsp_dir": null,
    "firmware": "rpu_firmware.elf",
    "_note": "The Cortex-R5 drives the kernels (doc/plans/RPU_PLAN.md §9): with enabled, deploy.py builds inference-scheduler/runtime/rpu against bsp_dir (the bitstream's R5 BSP, tools/rpu/make_r5_bsp.py), uploads it with board/kv260/rpu/rpu.dts + rpu-ipi.dts and starts it before the server; the libraries attach by themselves and each entry follows its INFERENCE_RPU_RECOMMENDED (src/rpu_policy.py).  --rpu BSP_DIR / --no-rpu override it for one deploy; --stop stops the firmware with the server."
  },
  "smollm2": {
    "_comment": "SmolLM2-135M-Instruct, served when server.backends contains smollm2. Its sampling and context settings are the server defaults for smollm2-360m and smolvlm too.",
    "lib": null,
    "_lib_note": "null = <remote.dir>/lib/libsmollm2.so (llm_board.py --install-only builds it).",
    "weights_dir": null,
    "_weights_dir_note": "Passed to llm_open(); null = the directory the library was built for.",
    "model_id": null,
    "_model_id_note": "null = the library's llm_model_name() (smollm2-135m-instruct).",
    "tokenizer": "assets/smollm2-135m-instruct/tokenizer.json",
    "_tokenizer_note": "Host path (demo/chat/assets is untracked); uploaded to <remote.dir>/smollm2/tokenizer.json.",
    "context": 1024,
    "reserve": 256,
    "_reserve_note": "Answer tokens kept free when the history is trimmed (max_tokens if smaller).",
    "temperature": 0.2,
    "top_p": 0.9,
    "top_k": 50,
    "repetition_penalty": 1.1,
    "dry_multiplier": 0.8,
    "dry_base": 1.75,
    "dry_allowed_length": 2,
    "dry_penalty_last_n": -1,
    "dry_sequence_breakers": [
      ":",
      "\"",
      "*"
    ],
    "_dry_note": "DRY (\"Don't Repeat Yourself\"): penalises a token that would extend a run already seen in the context, by multiplier * base^(run - allowed_length); a token containing a breaker string (and every special token) cuts a run. Newline is deliberately NOT a breaker (unlike text-generation-webui / llama.cpp): with it, loops of short lines slip through (CHAT_PLAN §15). dry_penalty_last_n -1 = the whole context, 0 = off.",
    "loop_guard": true,
    "_loop_guard_note": "End an answer whose generated tokens end in one block repeated verbatim 3 times (>= 24 tokens); finish_reason stop, kv260.finish 'loop'.",
    "_sampling_note": "Server defaults for requests that do not set them (the model card's 0.2 / 0.9, HF's top_k 50).",
    "cma_mb": 330
  },
  "smollm2_360m": {
    "_comment": "SmolLM2-360M-Instruct (CHAT_PLAN §20), served when server.backends contains smollm2-360m; the sampling defaults of the smollm2 block apply.",
    "lib": null,
    "_lib_note": "null = <remote.dir>/lib/libsmollm2_360m.so (llm_board.py --project build/llm_project_smollm2_360m --install-only builds it).",
    "weights_dir": null,
    "model_id": null,
    "_model_id_note": "null = the library's llm_model_name() (smollm2-360m-instruct).",
    "tokenizer": "assets/smollm2-360m-instruct/tokenizer.json",
    "_tokenizer_note": "Host path; uploaded to <remote.dir>/smollm2_360m/tokenizer.json.",
    "cma_mb": 775,
    "_cma_note": "The 758 MiB pool BO; with --resident auto it swaps with the other FPGA models."
  },
  "build": {
    "jobs": 4,
    "timeout": 1800
  },
  "board_lock": null,
  "_board_lock_note": "null = bert_squad_config board_lock, else the per-board default /tmp/kv260-board-<ssh.host>.lock (the lock every board tool takes). deploy.py holds flock() on it while it deploys (and with --hold until the server is stopped).",
  "health_timeout": 180,
  "smolvlm": {
    "_comment": "SmolVLM-256M-Instruct: chat about images (CHAT_PLAN §23). Served when server.backends contains smolvlm; the sampling defaults of the smollm2 block apply.",
    "lib": null,
    "_lib_note": "null = <remote.dir>/lib/libsmolvlm_256m.so (llm_board.py --project build/llm_project_smolvlm_256m --install-only builds it).",
    "weights_dir": null,
    "model_id": null,
    "tokenizer": "assets/smolvlm-256m-instruct/tokenizer.json",
    "_tokenizer_note": "Host path; uploaded to <remote.dir>/smolvlm/tokenizer.json.",
    "cma_mb": 550,
    "_cma_note": "The 495 MiB pool BO + the image buffer (520-530 MB measured); with --resident auto it swaps with SmolLM2-360M."
  },
  "piper": {
    "lib": null,
    "_lib_note": "null = <remote.dir>/lib/libpiper_tts.so (Piper text to speech, POST /v1/audio/speech; backend name \"piper\"). Built and installed with the voice by demo/tts/scripts/tts_board.py --install-only.",
    "weights_dir": "/root/piper_weights",
    "_weights_dir_note": "The voice directory: weights/*.dat of the library (the duration predictor's weights/dp.dat among them) and voice.json.",
    "model_id": null,
    "_model_id_note": "null = the model of voice.json (piper-lessac-medium).",
    "cma_mb": 55
  },
  "moonshine": {
    "lib": null,
    "_lib_note": "null = <remote.dir>/lib/libmoonshine_base.so (Moonshine speech to text, POST /v1/audio/transcriptions; backend name \"moonshine\"). Built and installed with its weights by demo/asr/scripts/asr_board.py --install-only; libmoonshine_tiny.so (with its weights_dir) serves the smaller model.",
    "weights_dir": "/root/moonshine_base_weights",
    "_weights_dir_note": "weights/*.dat of the library (asr_board.py uploads them there).",
    "tokenizer": "../asr/assets/moonshine-base/tokenizer.json",
    "_tokenizer_note": "The checkpoint's tokenizer.json on the host (demo/asr/scripts/asr_study.py fetch); deploy.py uploads it to <remote.dir>/moonshine/.",
    "model_id": null,
    "_model_id_note": "null = from the library's name (libmoonshine_base.so -> moonshine-base).",
    "cma_mb": 200,
    "max_seconds": 600,
    "_max_seconds_note": "The longest audio a request may send (seconds); long audio is transcribed in parts of at most 24.6 s, about 0.13 s of FPGA time per second of audio (base)."
  }
}
