{
  "_comment": "Copy to camera_config.json and edit. Paths are relative to demo/camera/.",

  "ssh": {
    "host": "kv260.local",
    "user": "root",
    "port": 22,

    "key_file": "~/.ssh/id_rsa",
    "_key_file_note": "Path to SSH private key; null for password auth.",

    "password": null,
    "connect_timeout": 15
  },

  "remote": {
    "work_dir": "/tmp/camera_demo",
    "_work_dir_note": "Per-run scratch directory on the board. Created if missing.",

    "uio_devices": {
      "VectorOPKernel": "fabric_vecop",
      "MatmulKernel":   "fabric_matmul",
      "ConvKernel":     "fabric_conv",
      "PoolKernel":     "fabric_pool"
    },
    "_uio_devices_note": "DT node labels from the loaded overlay. Verify with: cat /sys/class/uio/uio*/name. The bundled mobilenet_v1_1.0_224_no_softmax uses all four kernels: its 1x1 Conv classifier runs as a MatMul on MatmulKernel (the scheduler's fully-connected-Conv rewrite, --fc-conv).",

    "cmake_args": []
  },

  "local": {
    "driver_dirs": {
      "VectorOPKernel": "../../build/kernels/vectorop/kv260/vadd_kv260/solution1/impl/ip/drivers/VectorOPKernel_v1_0/src",
      "MatmulKernel":   "../../build/kernels/matmul_rtl/driver/MatmulKernel_v1_0/src",
      "ConvKernel":     "../../build/kernels/conv/kv260/conv_kv260/hls/impl/ip/drivers/ConvKernel_v1_0/src",
      "PoolKernel":     "../../build/kernels/pool/kv260/pool_kv260/hls/impl/ip/drivers/PoolingKernel_v1_0/src"
    },
    "_driver_dirs_note": "Per-kernel driver sources (the HLS exports; MatmulKernel's from make driver_matmul_rtl), copied into the project before upload."
  },

  "build": {
    "jobs": 4,
    "timeout": 600
  },

  "camera": {
    "width": 640,
    "height": 480,
    "fps": 30,
    "_note": "RealSense colour stream geometry. The frame is resized to preprocess.input_size before inference."
  },

  "run": {
    "use_sudo": true,
    "_use_sudo_note": "camera_loop.py is launched with sudo -n; the FPGA UIO devices and XRT buffers need root.",

    "board_python": "python3",
    "_board_python_note": "Python interpreter on the board with pyrealsense2/numpy/opencv. Use a full path for a venv, e.g. /usr/local/share/pynq-venv/bin/python3.",

    "warmup": 1,
    "top_k": 5,
    "target_fps": 0,
    "_target_fps_note": "Throttle the board loop to at most this rate. 0 = uncapped (FPGA inference is the real limit).",

    "power_poll_s": 2.0,
    "_power_poll_s_note": "How often the SOM power sensor is sampled (on a background thread). The overlay shows whole-board watts; source is XRT if available, else `xmutil xlnx_platformstats`, else hwmon.",

    "duration_s": 0,
    "_duration_s_note": "Auto-stop after this many seconds. 0 = run until you press 'q' (or Ctrl-C).",

    "env": {
      "_comment": "Per-run environment variables forwarded to the board camera loop."
    }
  },

  "preprocess": {
    "input_size": 224,
    "_input_size_note": "Square edge length each frame is resized to. MobileNetV1 1.0 expects 224.",
    "normalize": "tf",
    "_normalize_note": "'tf' = (pixel/127.5) - 1.0 (TF MobileNet); 'unit' = pixel/255; 'none' = pixel/256."
  },

  "display": {
    "poll_interval_ms": 40,
    "_poll_interval_ms_note": "How often the host SFTP-pulls the latest annotated frame.",
    "jpeg_quality": 80,
    "window_title": "Cormorant Camera Demo",
    "save_only": false,
    "_save_only_note": "true on a headless host: save streamed frames to build/stream/ instead of opening a window."
  },

  "models": [
    {
      "name": "mobilenet_v1",
      "drive_filename": "mobilenet_v1_1.0_224_no_softmax.onnx",
      "_drive_filename_note": "File name inside the Google Drive folder. The Softmax tail is stripped; the host applies softmax over the 1001 logits."
    }
  ],

  "drive": {
    "folder_url": "https://drive.google.com/drive/folders/1JBdhqHFw4Jh224maq0qNOZzKXrRgorJt",
    "_folder_url_note": "Google Drive folder containing the ONNX models. Downloaded with `gdown --folder`."
  },

  "labels": {
    "url": "https://storage.googleapis.com/download.tensorflow.org/data/imagenet_class_index.json",
    "_url_note": "Standard ImageNet 1000-class index. Class 0 (background) is prepended locally to match MobileNetV1's 1001-class output."
  },

  "cleanup": true
}
