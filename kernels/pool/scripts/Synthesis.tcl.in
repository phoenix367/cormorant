# Vitis HLS synthesis script for PoolingKernel — generated by CMake.
# Runs C synthesis and exports the result as a Vivado IP catalog archive.
#
# Variables substituted by CMake configure_file (@ONLY):
#   POOL_HLS_PROJECT_NAME   — HLS component directory name
#   POOL_BOARD_OPTION       — set_part command (includes -board if present)
#   POOL_SRC_SYNTHESIS      — kernel source file path
#   POOL_SYNTHESIS_FLAGS    — -O3 plus -I paths for include directories
#   POOL_TARGET_CLOCK_TCL   — target clock frequency in MHz
#   POOL_IP_OUTPUT_DIR      — output directory for the exported IP catalog
#
# Uses the Vitis unified "component" flow (open_component) rather than the
# legacy open_project/open_solution pair.  The component flow emits a
# <component>/<component>.hlscompile_summary file that Vitis Analyzer
# (`vitis -a <summary>`) opens; the legacy flow does not.  Reports land
# under <component>/hls/syn/report/ instead of solution1/syn/report/.

open_component -reset @POOL_HLS_PROJECT_NAME@ -flow_target vivado

@POOL_BOARD_OPTION@

add_files -cflags "@POOL_SYNTHESIS_FLAGS@" "@POOL_SRC_SYNTHESIS@"
set_top PoolingKernel

create_clock -period @POOL_TARGET_CLOCK_TCL@MHz -name default

# 64-bit AXI addresses for systems with >4 GB address space (e.g. KV260 PS DDR).
config_interface -m_axi_addr64
# Set m_axi bus width (controlled by CMake AXI_BUS_WIDTH).
config_interface -m_axi_max_widen_bitwidth @AXI_BUS_WIDTH@
# Do NOT add `config_interface -m_axi_min_bitwidth`: for the 16-bit element
# ports it makes the adapter emit one single-beat, partial-strobe write per
# element (8 AW transactions per 16 bytes) and the KV260 PS dropped every
# beat whose strobe lane was not lane 0 (2026-09-24).  Ports that must be
# wide are declared wide in the C++ (ap_uint<128> WeightWord).  The block
# design's C_M_AXI_*_DATA_WIDTH instance parameters must equal the exported
# IP defaults — widening them in IP integrator leaves the wrapper's
# C_M_AXI_*_WSTRB_WIDTH literal at 4 bits.
config_rtl -reset_level low

csynth_design
export_design -format ip_catalog -output @POOL_IP_OUTPUT_DIR@

exit
