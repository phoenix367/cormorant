#pragma once

#include <cstdint>
@CONV_DATA_TYPE_INCLUDE@
@CONV_HAVE_APFIXED_DEFINE@

// ---------------------------------------------------------------------------
// Element and accumulator types — configured by CMake.
//
// Default (Vitis HLS available):
//   Data_t    = ap_fixed<16,8>   range [-128, 127.996], 1/256 LSB
//   AccData_t = ap_fixed<32,16>  range [-32768, 32767.999]
//
// Fallback (no Vitis HLS):
//   Data_t    = float
//   AccData_t = float           (no saturation; reference only)
//
// AccData_t overflow for ap_fixed<16,8> inputs:
//   worst-case product  ≈ 128^2 = 16384
//   ap_fixed<32,16> max ≈ 32767
//   safe for C×kH×kW ≤ 2 (worst case) / ≤ ~32768 (|values| ≤ 1 typical)
//   Use ap_fixed<40,24> via CONV_ACC_DATA_TYPE for deeper reductions.
// ---------------------------------------------------------------------------
using Data_t    = @CONV_DATA_TYPE@;
using AccData_t = @CONV_ACC_DATA_TYPE@;

// ---------------------------------------------------------------------------
// Tile-size constants — compile-time parameters for the HLS kernel.
//
// kTileM   Output channel tile.  Must be a power of two so that
//          ri & (kTileM-1) compiles to a bitwise AND for the II=1 lane
//          rotation, and so that the dependency distance for acc[m1] equals
//          kTileM ≥ MAC latency (~3 cycles for ap_fixed<16,8>).
//
// kTileIC  Input channel tile.  Power of two; sets the w_buf and patch
//          buffer depth in the IC dimension.
//
// kMaxKH   Compile-time upper bound on kernel height.
// kMaxKW   Compile-time upper bound on kernel width.
//          Models with kH > kMaxKH or kW > kMaxKW are rejected by the
//          inference scheduler at validation time.
// ---------------------------------------------------------------------------
static constexpr unsigned kTileM   = @CONV_TILE_M@;
static constexpr unsigned kTileIC  = @CONV_TILE_IC@;
static constexpr unsigned kMaxKH   = @CONV_MAX_KH@;
static constexpr unsigned kMaxKW   = @CONV_MAX_KW@;

// ---------------------------------------------------------------------------
// kMaxInCh / kMaxOutCh / kMaxLineBufCols / kMaxLineBufRows / kMaxAccPersistEntries
//
// Compile-time upper bounds for the on-chip buffers in the standard-conv
// path.  The Option-A IC-tiling design shrinks the per-channel buffers
// (line_buf, broadcast local_buf, w_buf) from kMaxInCh to kTileIC channels
// at the cost of keeping a persistent partial-output buffer of
// kMaxAccPersistEntries elements that survives across ic-tiles.
//
//   * line_buf   — sized kTileIC * kMaxLineBufRows * kMaxLineBufCols.
//                  Per-channel sliding window over rows (circular slot
//                  = ih & (kMaxLineBufRows-1)) AND columns (circular
//                  slot = iw & (kMaxLineBufCols-1)).  Within an
//                  (ow-tile, chunk, ic-tile) each input pixel in the
//                  tile's iw range is fetched from DDR exactly once per
//                  (ni, channel); at tile boundaries the
//                  (kw-1)*dilation_w-col overlap is re-fetched, and at
//                  chunk boundaries the (kh-1)*stride_h-row overlap is
//                  re-fetched (duplicate reads accepted in exchange for
//                  not capping in_h or in_w).
//   * bias_buf   — sized kMaxOutCh.  Entire bias is loaded once and
//                  replayed in (r,mt,m1) order.
//   * partial_outputs — sized kMaxAccPersistEntries (flat).  Holds one
//                  output CHUNK's chunk_oh_count*out_w*out_ch_padded
//                  AccData_t accumulators (out_ch padded up to a multiple
//                  of kTileM so each m-tile is one aligned reshaped word)
//                  that survive across ic-tiles within the chunk; initialised from bias at chunk start and
//                  drained to acc_stream at chunk end.  Chunking along
//                  the oh axis lets the kernel handle outputs larger
//                  than the buffer; see compute_oh_chunking() in
//                  ConvKernel.cpp for the strategy.  Bound to URAM
//                  (BIND_STORAGE impl=URAM) so it consumes no BRAM —
//                  kMaxAccPersistEntries is sized against the idle
//                  URAM pool (4096 AccData_t entries per URAM block).
//
// Constraints (validated by the inference scheduler):
//   in_ch    <= kMaxInCh
//   out_ch   <= kMaxOutCh
//   (kh-1)*dilation_h + 1 <= kMaxLineBufRows   (kernel-height window fits)
//   (kw-1)*dilation_w + 1 <= kMaxLineBufCols   (kernel-width window fits)
//   out_w * ceil(out_ch/kTileM)*kTileM <= kMaxAccPersistEntries
//                                              (one kTileM-padded output row fits)
//
// in_h, in_w, and out_h are NOT capped by the kernel — wider/taller layers
// are handled by oh-chunking and ow-tiling, which split those axes into
// units that fit on-chip and accept duplicated reads at tile/chunk
// boundaries.  See compute_oh_chunking() and compute_ow_tiling() in
// ConvKernel.cpp.
//
// kMaxLineBufRows and kMaxLineBufCols must be powers of 2 (bitmasks
// replace modulo in the slot computation).
// ---------------------------------------------------------------------------
static constexpr unsigned kMaxInCh             = @CONV_MAX_IN_CH@;
static constexpr unsigned kMaxOutCh            = @CONV_MAX_OUT_CH@;
static constexpr unsigned kMaxLineBufCols      = @CONV_MAX_LINE_BUF_COLS@;
static constexpr unsigned kMaxLineBufRows      = @CONV_MAX_LINE_BUF_ROWS@;
static constexpr unsigned kMaxAccPersistEntries = @CONV_MAX_ACC_PERSIST_ENTRIES@;

// ---------------------------------------------------------------------------
// kMaxMperGroup — max number of mt-tiles cached together in the standard
// path's (ict, M-group) weight slab.
//
// The weight-caching restructure hoists the weight load out of the inner
// (oh, ow) sweep so each DDR weight is read once per (ni, chunk, ict)
// instead of out_h*out_w times.  When out_ch is large enough that all
// m_tiles' weights for one ic-tile don't fit the on-chip cache, the
// kernel processes M in groups of mt_per_group mt-tiles; each group's
// weights are loaded once and reused across the (oh, ow) sweep, then the
// next group reloads.  Patches are re-emitted from line_buf per m_group
// (no DDR re-read).
//
// Group size at runtime:
//   m_tiles      = ceil(out_ch / kTileM)
//   mt_per_group = min(kMaxMperGroup, m_tiles)
//   num_m_groups = ceil(m_tiles / mt_per_group)
//
// Compile-time buffer size:
//   w_cache[kMaxMperGroup][kTileM][kTileIC][kMaxKH][kMaxKW]
//   = kMaxMperGroup · 8 · 16 · 7 · 7 = 6272·kMaxMperGroup entries.
//
// Trade-off: larger kMaxMperGroup → more layers run in a single group
// (zero weight replay) but consumes more BRAM/LUT for w_cache.  When
// m_tiles ≤ kMaxMperGroup the kernel single-groups; larger m_tiles
// split into ceil(m_tiles / kMaxMperGroup) groups.
// ---------------------------------------------------------------------------
static constexpr unsigned kMaxMperGroup        = @CONV_MAX_M_PER_GROUP@;

static_assert(
    (kMaxLineBufRows & (kMaxLineBufRows - 1)) == 0,
    "kMaxLineBufRows must be a power of 2 (it is used as a bitmask)"
);

static_assert(
    (kMaxLineBufCols & (kMaxLineBufCols - 1)) == 0,
    "kMaxLineBufCols must be a power of 2 (it is used as a bitmask)"
);

// ---------------------------------------------------------------------------
// kAxiBusWidth — m_axi master data-bus width in bits.
//
// Recorded here for reference; the kernel C++ logic does not use it.  It is
// the AXI_BUS_WIDTH build option (a top-level CMakeLists.txt cache variable;
// default 32, allowed 32 / 64 / 128 / 256 / 512), applied at C synthesis by
// the generated scripts/Synthesis.tcl.in (and Cosim.tcl.in) via:
//     config_interface -m_axi_max_widen_bitwidth <kAxiBusWidth>
//
// It caps how wide HLS may auto-widen the gmem0..3 m_axi adapters.  A wider
// bus moves more elements per burst beat (fewer DDR transactions), but it
// MUST match the AXI data width of the Vivado block design the exported IP
// is integrated into (MAXI_DATA_WIDTH on each kernel IP) — e.g. configure
// with -DAXI_BUS_WIDTH=128 for a 128-bit block design.
// ---------------------------------------------------------------------------
static constexpr unsigned kAxiBusWidth = @AXI_BUS_WIDTH@;

static constexpr unsigned kSeed    = 42;
